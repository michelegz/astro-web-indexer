# Nginx configuration
NGINX_PORT=2080

# Database configuration
DB_HOST=mariadb
DB_NAME=awi_db
DB_USER=awi_user
DB_PASSWORD=awi_password

# Soft-delete retention period in days
RETENTION_DAYS=7

# Number of worker processes for indexing (default is 4)
INDEXER_WORKERS=4

# Enable debug logging for indexing scripts (true/false)
DEBUG=false
THUMB_SIZE=300


MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306

# Application configuration
HEADER_TITLE=Astro Web Indexer

# Data paths
FITS_DATA_PATH=./data/fits

# Authentication configuration
# AUTH_MODE: 'none' = no auth (default), 'open' = guest + optional login, 'full' = login required
AUTH_MODE=none

# Initial admin user (created automatically on first startup when AUTH_MODE is not 'none')
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Guest settings (only used when AUTH_MODE=open)
# Allow guests to download files (true/false)
GUEST_CAN_DOWNLOAD=false
# Comma-separated list of root directories accessible to guests (empty = all directories)
GUEST_ALLOWED_DIRS=