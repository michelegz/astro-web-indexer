# Nginx configuration
NGINX_PORT=2080

# Database configuration
DB_HOST=mariadb
DB_NAME=awi_db
DB_USER=awi_user
DB_PASSWORD=awi_password

# Soft-delete retention period in days
RETENTION_DAYS=7

# Number of worker processes for indexing (default is 4)
INDEXER_WORKERS=4

# How the indexing is split:
#   two    - the file is written first (header, preview, frame statistics) so it
#            shows up in the frontend, and the star metrics are computed after
#   single - everything in one pass: the pixels are decoded once, but nothing
#            is visible until the metrics are known
INDEXER_PHASE_MODE=two

# Enable debug logging for indexing scripts (true/false)
DEBUG=false
THUMB_SIZE=300
# Polling interval in seconds for the filesystem watcher when inotify is not supported
# (e.g. Docker Desktop on Windows). Has no effect when native inotify is used.
POLL_INTERVAL=30
# Set to 'true' to force polling even on systems that support inotify
FORCE_POLLING=false
# Star/quality metrics for LIGHT frames (HFR, FWHM, eccentricity, star count,
# SNR weight, PSF signal). Set to 'false' to skip computation and hide the columns.
STAR_METRICS_ENABLED=true

# How the star metrics are measured:
#   default   - 5.0 sigma, minimum area 9 px: what the indexer has always done
#   fast      - 7.0 sigma, minimum area 12 px: the bright, well resolved stars
#               only (about twice as fast, the HFR moves by ~2%)
#   sensitive - 3.5 sigma, minimum area 9 px: every faint source counted
#               (about a third slower, the HFR moves by ~4%)
# Changing it does not touch the files already indexed: re-measure them with
#   docker exec -it awi-python python /opt/scripts/reindex.py /var/fits --recompute-star-metrics
STAR_METRICS_PROFILE=default


MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306

# Application configuration
HEADER_TITLE=Astro Web Indexer

# Data paths
FITS_DATA_PATH=./data/fits

# Authentication configuration
# AUTH_MODE: 'none' = no auth (default), 'full' = login required with directory permissions
AUTH_MODE=none

# Initial admin user (created automatically on first startup when AUTH_MODE is not 'none')
ADMIN_USER=admin
ADMIN_PASSWORD=changeme