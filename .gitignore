# Temporary files
*.tmp
*.bak
*.swp

# Continue
.continue
.continue/*

# dev files
awi-images*.tar
docker-save.bat
# docker-compose.override.yml is NOT loaded any more: Compose used to auto-load
# that name, and build.sh now names its files explicitly. A copy left behind
# has no effect and is kept ignored so it does not become untracked noise
# someone commits by accident. The shared development layer is
# docker-compose.dev.yml, which IS tracked.
/docker-compose.override.yml
/docker-compose.override.yml.off
/src/VERSION
/releases/

# Node.js
/node_modules
npm-debug.log

# CSS output
/src/assets/css/output.css

#composer
/src/vendor
/src/vendor/*

# Test files
src/test.php

# Release script
publish.sh

#vite
/awi-vite-project

#temporary files
/tmp